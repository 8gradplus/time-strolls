timestrolls.debtray.com: {
    route /api/*  {
        reverse_proxy api:8000
    }
    # the OAuth metadata of the API's sign-in (MCP clients look it up here)
    @oauth path /.well-known/oauth-* /.well-known/openid-configuration*
    reverse_proxy @oauth api:8000
    reverse_proxy frontend:3000
    tls v.atalla@debtray.com
}
